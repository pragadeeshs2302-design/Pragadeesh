# Copy this file to ".env" and edit the values.

# MongoDB connection string
#  - Local MongoDB (MongoDB Community Server installed on your PC):
MONGODB_URI=mongodb://127.0.0.1:27017/sas_jewellery
#  - MongoDB Atlas (cloud) example - replace user, password and cluster:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sas_jewellery?retryWrites=true&w=majority

PORT=5000

# Admin login used on the "Admin Login" page
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# Optional: fixed secret for login tokens (random one is generated and saved in MongoDB if empty)
JWT_SECRET=
